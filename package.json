{
  "name": "gemut-immobiliare-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "worker:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "worker:db:migrate:local": "wrangler d1 migrations apply gemut-leads-db --local --config cloudflare/wrangler.jsonc",
    "worker:db:migrate": "wrangler d1 migrations apply gemut-leads-db --remote --config cloudflare/wrangler.jsonc",
    "worker:turnstile": "node scripts/provision-turnstile.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.323.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.16",
    "wrangler": "^4.111.0"
  }
}
